---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const home = '/';
const quotes = '/quotes/';
const random = '/random/';
const search = '/search/';
const rss = '/rss.xml';
const isCurrent = (href: string) =>
  currentPath === href ||
  currentPath === href.replace(/\/$/, '') ||
  (href !== home && currentPath.startsWith(href));
const desktopLink = (href: string) =>
  `flex min-h-[44px] items-center px-1 text-[16px] font-medium transition-colors duration-150 ${
    isCurrent(href)
      ? 'text-brand underline decoration-2 underline-offset-8 dark:text-brand-dark'
      : 'text-muted hover:text-ink dark:text-text-dark-2 dark:hover:text-brand-dark'
  }`;
const themeBtnClass = 'flex min-h-[44px] items-center gap-1.5 text-[15px] font-medium text-muted transition-colors duration-150 hover:text-ink dark:text-text-dark-3 dark:hover:text-brand-dark';
---

<!-- Header v2: one slim sticky bar (64px), solid and opaque — no
     backdrop-blur, so content never bleeds through. No utility bar:
     the theme toggle lives in the bar itself, RSS lives in the mobile
     menu and footer. Desktop nav always visible; hamburger is
     mobile-only. Every target >= 44px. -->
<div id="header-sentinel" aria-hidden="true" class="h-px"></div>
<header id="site-header" class="sticky top-0 z-40 border-b border-border bg-paper dark:border-border-dark dark:bg-paper-dark">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex min-h-[64px] items-center gap-3">
      <a href={home} class="flex min-h-[44px] shrink-0 items-center gap-2.5" aria-label="KumQuote — home">
        <img src="/favicon.svg" alt="" aria-hidden="true" width="36" height="36" class="size-9 shrink-0" />
        <span class="font-display text-[22px] font-bold leading-none tracking-tight text-ink dark:text-text-dark">KumQuote</span>
      </a>

      <nav aria-label="Primary navigation" class="ms-6 hidden items-center gap-6 sm:flex">
        <a href={home} aria-current={isCurrent(home) ? 'page' : undefined} class={desktopLink(home)}><span class="link-underline">Home</span></a>
        <a href={quotes} aria-current={isCurrent(quotes) ? 'page' : undefined} class={desktopLink(quotes)}><span class="link-underline">Quotes</span></a>
        <a href={random} aria-current={isCurrent(random) ? 'page' : undefined} class={desktopLink(random)}><span class="link-underline">Random</span></a>
      </nav>

      <div class="ms-auto flex items-center gap-1 sm:gap-2">
        <!-- Theme: System / Light / Dark. The button shows the CURRENT
             mode; clicking cycles System -> Light -> Dark -> System.
             Stored in localStorage as 'kumquote-theme'. -->
        <button
          type="button"
          id="theme-toggle"
          aria-label="Theme: System. Activate to switch to Light."
          aria-pressed="false"
          class={themeBtnClass}
        >
          <svg aria-hidden="true" class="theme-icon inline-block transition-transform duration-250" width="16" height="16" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.8"/><path d="M10 2a8 8 0 0 1 0 16z" fill="currentColor"/></svg>
          <span class="theme-label">System</span>
        </button>
        <a href={search} aria-current={isCurrent(search) ? 'page' : undefined} class="hidden min-h-[44px] items-center rounded-lg bg-ink px-4 text-[15px] font-semibold text-cream transition-opacity duration-150 hover:opacity-90 dark:bg-brand-dark dark:text-paper-dark sm:flex">
          Search
        </a>
        <button
          type="button"
          id="menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Menu"
          data-menu-label="Menu"
          data-close-label="Close"
          class="flex min-h-[44px] min-w-[44px] flex-col items-center justify-center gap-1.5 rounded-lg border border-border px-3 dark:border-border-dark-2 sm:hidden"
        >
          <span aria-hidden="true" class="menu-bar block h-[2px] w-5 bg-current transition-transform duration-250"></span>
          <span aria-hidden="true" class="menu-bar block h-[2px] w-5 bg-current transition-transform duration-250"></span>
          <span aria-hidden="true" class="menu-bar block h-[2px] w-5 bg-current transition-transform duration-250"></span>
          <span class="sr-only menu-label">Menu</span>
        </button>
      </div>
    </div>

  </div>
</header>

<!-- Full-screen mobile menu: a real modal dialog, not a dropdown.
     Hidden with display:none until opened (links never keyboard-
     focusable while closed). Focus trapped, Escape closes, body
     scroll locks, focus returns to the hamburger. -->
<div
  id="mobile-nav"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation"
  data-open="false"
  class="mobile-menu fixed inset-0 z-50 hidden flex-col bg-paper dark:bg-paper-dark sm:hidden"
>
  <div class="mx-auto flex min-h-[64px] w-full max-w-6xl items-center justify-between gap-3 px-4">
    <span class="flex items-center gap-2.5">
      <img src="/favicon.svg" alt="" aria-hidden="true" width="36" height="36" class="size-9 shrink-0" />
      <span class="font-display text-[22px] font-bold leading-none tracking-tight text-ink dark:text-text-dark">KumQuote</span>
    </span>
    <button
      type="button"
      id="menu-close"
      aria-label="Close"
      class="flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg border border-border dark:border-border-dark-2"
    >
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
  </div>
  <nav aria-label="Primary navigation" class="mx-auto w-full max-w-6xl flex-1 px-4 pt-6">
    <a href={home} aria-current={isCurrent(home) ? 'page' : undefined} class="menu-link flex min-h-[64px] items-center border-b border-border font-display text-[32px] font-bold text-ink dark:border-border-dark dark:text-text-dark">Home</a>
    <a href={quotes} aria-current={isCurrent(quotes) ? 'page' : undefined} class="menu-link flex min-h-[64px] items-center border-b border-border font-display text-[32px] font-bold text-ink dark:border-border-dark dark:text-text-dark">Quotes</a>
    <a href={random} aria-current={isCurrent(random) ? 'page' : undefined} class="menu-link flex min-h-[64px] items-center border-b border-border font-display text-[32px] font-bold text-ink dark:border-border-dark dark:text-text-dark">Random</a>
    <a href={search} aria-current={isCurrent(search) ? 'page' : undefined} class="menu-link flex min-h-[64px] items-center border-b border-border font-display text-[32px] font-bold text-ink dark:border-border-dark dark:text-text-dark">Search</a>
  </nav>
  <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-6 px-4 pb-8">
    <a href={rss} class="flex min-h-[44px] items-center text-[16px] font-medium text-muted dark:text-text-dark-3">RSS</a>
    <p class="w-full text-[15px] text-muted dark:text-text-dark-3">Quotes worth remembering</p>
  </div>
</div>

<script>
  const header = document.getElementById('site-header');
  const sentinel = document.getElementById('header-sentinel');
  if (header && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      header.classList.toggle('header-scrolled', !entry.isIntersecting);
    }).observe(sentinel);
  }

  /* Theme: System / Light / Dark. 'system' means follow the OS and
     react when the OS changes; 'light'/'dark' are fixed. The mode
     lives on <html data-theme> (set before paint in BaseLayout) and
     in localStorage as 'kumquote-theme'. */
  const THEME_KEY = 'kumquote-theme';
  const MODES = ['system', 'light', 'dark'];
  const LABELS = { system: 'System', light: 'Light', dark: 'Dark' };
  const mq = window.matchMedia('(prefers-color-scheme: dark)');
  const themeBtn = document.getElementById('theme-toggle');
  const themeLabelEl = themeBtn?.querySelector('.theme-label');
  const themeIconEl = themeBtn?.querySelector('.theme-icon');
  function currentMode() {
    const m = document.documentElement.dataset.theme;
    return m === 'light' || m === 'dark' ? m : 'system';
  }
  function applyTheme(mode) {
    const dark = mode === 'dark' || (mode === 'system' && mq.matches);
    document.documentElement.dataset.theme = mode;
    document.documentElement.classList.toggle('dark', dark);
    if (themeLabelEl) themeLabelEl.textContent = LABELS[mode];
    const next = MODES[(MODES.indexOf(mode) + 1) % MODES.length];
    themeBtn?.setAttribute('aria-label', `Theme: ${LABELS[mode]}. Activate to switch to ${LABELS[next]}.`);
    themeBtn?.setAttribute('aria-pressed', String(dark));
    if (themeIconEl) themeIconEl.style.transform = dark ? 'rotate(180deg)' : 'rotate(0deg)';
  }
  applyTheme(currentMode());
  mq.addEventListener('change', () => {
    if (currentMode() === 'system') applyTheme('system');
  });
  themeBtn?.addEventListener('click', () => {
    const next = MODES[(MODES.indexOf(currentMode()) + 1) % MODES.length];
    try {
      localStorage.setItem(THEME_KEY, next);
    } catch {
      /* private mode: theme just lasts for this session */
    }
    applyTheme(next);
  });

  const menuBtn = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const menuCloseBtn = document.getElementById('menu-close');
  const menuLabelEl = menuBtn?.querySelector('.menu-label');
  const bars = menuBtn?.querySelectorAll('.menu-bar');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let previousOverflow = '';
  let menuCloseTimer = null;
  const focusableInMenu = () => Array.from(mobileNav?.querySelectorAll('a[href], button:not([disabled])') ?? []).filter((el) => el.offsetParent !== null || el === document.activeElement);
  const setMenuOpen = (open) => {
    if (!mobileNav || !menuBtn) return;
    if (menuCloseTimer) { clearTimeout(menuCloseTimer); menuCloseTimer = null; }
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? menuBtn.dataset.closeLabel ?? 'Close' : menuBtn.dataset.menuLabel ?? 'Menu');
    if (menuLabelEl) menuLabelEl.textContent = open ? menuBtn.dataset.closeLabel ?? 'Close' : menuBtn.dataset.menuLabel ?? 'Menu';
    if (bars && bars.length === 3) {
      bars[0].style.transform = open ? 'translateY(8px) rotate(45deg)' : '';
      bars[1].style.opacity = open ? '0' : '1';
      bars[2].style.transform = open ? 'translateY(-8px) rotate(-45deg)' : '';
    }
    if (open) {
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      mobileNav.classList.remove('hidden');
      mobileNav.classList.add('flex');
      requestAnimationFrame(() => {
        mobileNav.setAttribute('data-open', 'true');
        const first = focusableInMenu()[0];
        first?.focus();
      });
    } else {
      mobileNav.setAttribute('data-open', 'false');
      const finishClose = () => {
        mobileNav.classList.add('hidden');
        mobileNav.classList.remove('flex');
        document.body.style.overflow = previousOverflow;
        menuBtn.focus();
      };
      if (reducedMotion) {
        finishClose();
      } else {
        menuCloseTimer = setTimeout(finishClose, 300);
      }
    }
  };
  menuBtn?.addEventListener('click', () => {
    setMenuOpen(mobileNav?.getAttribute('data-open') !== 'true');
  });
  menuCloseBtn?.addEventListener('click', () => setMenuOpen(false));
  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });
  mobileNav?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenuOpen(false);
      return;
    }
    if (event.key !== 'Tab') return;
    const focusable = focusableInMenu();
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
