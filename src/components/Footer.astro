---
import { categoryCounts } from '../lib/quotes';

const categories = (await categoryCounts()).slice(0, 6);
const linkClass = 'flex min-h-[44px] items-center gap-2 text-[17px] text-stone-700 transition-colors duration-150 hover:text-brand dark:text-text-dark-2 dark:hover:text-brand-dark';
---

<!-- Footer: grid, then a separate Back to top row, then the copyright
     row below it. One Back to top link in the whole footer. -->
<footer class="mt-12 border-t border-stone-200 bg-white px-4 py-12 dark:border-border-dark dark:bg-surface-dark">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-5">
    <div class="col-span-2 lg:col-span-1">
      <a href="/" class="flex min-h-[44px] items-center gap-2.5" aria-label="KumQuote — home">
        <img src="/favicon.svg" alt="" aria-hidden="true" width="36" height="36" class="size-9 shrink-0" />
        <span class="font-display text-[22px] leading-none tracking-tight text-ink dark:text-text-dark">KumQuote</span>
      </a>
      <p class="mt-4 max-w-[45ch] text-[17px] leading-relaxed text-stone-600 dark:text-text-dark-3">Quotes worth remembering — with the meaning behind them, not just the words.</p>
    </div>

    <nav aria-label="Explore">
      <h2 class="font-display text-[22px] text-ink dark:text-text-dark">Explore</h2>
      <ul class="mt-4">
        <li><a href="/" class={linkClass}>Home</a></li>
        <li><a href="/quotes/" class={linkClass}>All quotes</a></li>
        <li><a href="/random/" class={linkClass}>Random quote</a></li>
        <li><a href="/search/" class={linkClass}>Search</a></li>
      </ul>
    </nav>

    <nav aria-label="Categories">
      <h2 class="font-display text-[22px] text-ink dark:text-text-dark">Categories</h2>
      <ul class="mt-4">
        {categories.map(({ category, count }) => (
          <li><a href={`/category/${category}/`} class={linkClass}><span class="capitalize">{category}</span><span class="text-sm text-stone-500 dark:text-text-dark-3">({count})</span></a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Follow">
      <h2 class="font-display text-[22px] text-ink dark:text-text-dark">Follow</h2>
      <ul class="mt-4">
        <li><a href="/rss.xml" class={linkClass}>RSS</a></li>
        <li><a href="/sitemap.xml" class={linkClass}>Sitemap</a></li>
      </ul>
    </nav>

    <nav aria-label="Legal">
      <h2 class="font-display text-[22px] text-ink dark:text-text-dark">Legal</h2>
      <ul class="mt-4">
        <li><a href="/privacy-policy/" class={linkClass}>Privacy Policy</a></li>
        <li><a href="/terms-and-conditions/" class={linkClass}>Terms and Conditions</a></li>
        <li><a href="/disclaimer/" class={linkClass}>Disclaimer</a></li>
      </ul>
    </nav>
  </div>

  <div class="mx-auto mt-12 flex max-w-6xl justify-end border-t border-stone-200 pt-6 dark:border-border-dark">
    <a href="#top" class="flex min-h-[44px] items-center gap-2 font-medium text-brand underline dark:text-brand-dark">Back to top ↑</a>
  </div>
  <p class="mt-6 text-center text-sm text-stone-500 dark:text-text-dark-3">© {new Date().getFullYear()} KumQuote, kumquote.pages.dev</p>
</footer>
