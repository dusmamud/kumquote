---
import type { QuoteEntry } from '../lib/quotes';
import { quoteUrl, authorUrl, categoryUrl, isoDate, quoteSlug, quoteTitle } from '../lib/quotes';

interface Props {
  entry: QuoteEntry;
}

const { entry } = Astro.props;
const { text, author, category } = entry.data;
---
<!-- Poster card: white surface, gold top rule, Playfair Bold quote,
     author in letterspaced caps (research: attribution in a quiet
     sans, small, caps). No shadow on resting cards; hover lift is in
     global.css (.poster-card, motion v3). -->
<article data-reveal class="poster-card flex flex-col rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark">
  <span aria-hidden="true" class="h-1 w-10 rounded-full bg-gold"></span>
  <blockquote class="mt-4 font-display text-display-card font-bold tracking-[-0.01em] text-ink dark:text-text-dark">
    <a href={quoteUrl(entry)} class="transition-colors duration-150 hover:text-brand dark:hover:text-brand-dark">“{text}”</a>
  </blockquote>
  <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-[15px] text-muted dark:text-text-dark-3">
    <a href={authorUrl(author)} class="font-semibold uppercase tracking-[0.08em] text-brand dark:text-brand-dark">{author}</a>
    <span aria-hidden="true">·</span>
    <a href={categoryUrl(category)} class="capitalize underline decoration-border underline-offset-4 hover:text-brand dark:decoration-border-dark-2 dark:hover:text-brand-dark">{category}</a>
    <span aria-hidden="true">·</span>
    <time datetime={isoDate(entry.data.pubDate)}>{isoDate(entry.data.pubDate)}</time>
    <button type="button" data-fav-slug={quoteSlug(entry)} aria-pressed="false" aria-label={`Save “${quoteTitle(entry)}” to favorites`} class="fav-btn ms-auto flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg text-muted transition-colors duration-150 hover:text-brand dark:text-text-dark-3 dark:hover:text-brand-dark">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></svg>
    </button>
  </p>
</article>
