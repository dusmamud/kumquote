---
import BaseLayout from '../../layouts/BaseLayout.astro';

const site = Astro.site?.toString() ?? 'https://kumquote.pages.dev/';
---
<BaseLayout
  title="Contact — KumQuote"
  description="How to reach KumQuote — quote suggestions, corrections, and feedback."
  canonical={`${site}contact/`}
  currentPath="/contact/"
  breadcrumbs={[{ name: 'Home', url: site }, { name: 'Contact', url: `${site}contact/` }]}
>
  <h1 data-reveal class="font-display text-display-h1 font-bold text-ink dark:text-text-dark">Contact</h1>
  <p class="mt-3 max-w-[65ch] text-lg leading-relaxed text-muted dark:text-text-dark-3">KumQuote does not have an email inbox yet. Here is how to reach us:</p>

  <section aria-label="Ways to reach us" class="mt-10 max-w-[65ch]">
    <ul class="grid gap-5">
      <li data-reveal class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark">
        <h2 class="font-display text-xl font-bold text-ink dark:text-text-dark">Suggest a quote</h2>
        <p class="mt-2 leading-relaxed text-muted dark:text-text-dark-3">Know a quote that belongs here? Use the <a href="/submit/" class="font-semibold text-brand underline dark:text-brand-dark">submit a quote</a> page — it opens a pre-filled suggestion on GitHub.</p>
      </li>
      <li data-reveal class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark">
        <h2 class="font-display text-xl font-bold text-ink dark:text-text-dark">Corrections and feedback</h2>
        <p class="mt-2 leading-relaxed text-muted dark:text-text-dark-3">Wrong attribution, a mistake on a page, or an idea for the site? <a href="https://github.com/dusmamud/kumquote/issues/new" target="_blank" rel="noopener noreferrer" class="font-semibold text-brand underline dark:text-brand-dark">Open an issue on GitHub</a> — it is the fastest way to reach us, and corrections are welcome.</p>
      </li>
      <li data-reveal class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark">
        <h2 class="font-display text-xl font-bold text-ink dark:text-text-dark">Anything else</h2>
        <p class="mt-2 leading-relaxed text-muted dark:text-text-dark-3">KumQuote is made and curated by Dus Mamud. The site itself lives at <a href="https://kumquote.pages.dev/" class="font-semibold text-brand underline dark:text-brand-dark">kumquote.pages.dev</a>.</p>
      </li>
    </ul>
  </section>
</BaseLayout>
