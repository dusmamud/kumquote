---
import BaseLayout from '../../layouts/BaseLayout.astro';

const site = Astro.site?.toString() ?? 'https://kumquote.pages.dev/';
---
<BaseLayout
  title="Random quote — KumQuote"
  description="A random quote from KumQuote — refresh for another one."
  canonical={`${site}random/`}
  currentPath="/random/"
>
  <h1 class="font-display text-4xl">Random quote</h1>
  <p class="mt-3 text-lg text-stone-600 dark:text-text-dark-3">A static site has no server to pick a random quote, so this page picks one in your browser from the full quote list.</p>

  <div class="mt-8 rounded-2xl border border-stone-200 bg-white p-6 dark:border-border-dark dark:bg-surface-dark">
    <blockquote id="random-text" class="font-display text-3xl leading-snug text-ink dark:text-text-dark">Loading a quote…</blockquote>
    <p class="mt-4 text-lg text-stone-600 dark:text-text-dark-3">
      — <a id="random-author" href="/quotes/" class="font-medium text-brand underline dark:text-brand-dark">…</a>
      <span id="random-category" class="ms-2 text-[15px] text-stone-500 dark:text-text-dark-3"></span>
    </p>
    <p class="mt-6 flex flex-wrap gap-3">
      <button
        type="button"
        id="random-again"
        class="flex min-h-[44px] items-center rounded-lg bg-brand px-5 text-[15px] text-white transition-opacity duration-150 hover:opacity-90 dark:bg-brand-dark dark:text-paper-dark"
      >
        Another quote
      </button>
      <a id="random-link" href="/quotes/" class="flex min-h-[44px] items-center rounded-lg border border-stone-300 px-5 text-[15px] font-medium transition-colors duration-150 hover:border-brand hover:text-brand dark:border-border-dark-2 dark:hover:border-brand-dark dark:hover:text-brand-dark">Read the meaning →</a>
    </p>
  </div>
  <noscript><p class="mt-6">Random quotes need JavaScript. Browse <a href="/quotes/" class="font-medium text-brand underline dark:text-brand-dark">all quotes</a> instead.</p></noscript>

  <script>
    // Quotes come from /quotes-data.json (built at build time).
    // Everything is inserted as text, never as HTML.
    const textEl = document.getElementById('random-text');
    const authorEl = document.getElementById('random-author');
    const categoryEl = document.getElementById('random-category');
    const linkEl = document.getElementById('random-link');
    const againBtn = document.getElementById('random-again');
    let quotes = [];
    let lastIndex = -1;

    function pick() {
      if (quotes.length === 0) return;
      let i = Math.floor(Math.random() * quotes.length);
      if (quotes.length > 1) {
        while (i === lastIndex) i = Math.floor(Math.random() * quotes.length);
      }
      lastIndex = i;
      const q = quotes[i];
      if (textEl) textEl.textContent = `“${q.text}”`;
      if (authorEl) {
        authorEl.textContent = q.author;
        authorEl.href = `/author/${q.authorSlug}/`;
      }
      if (categoryEl) categoryEl.textContent = q.category;
      if (linkEl) linkEl.href = q.url;
    }

    fetch('/quotes-data.json')
      .then((r) => r.json())
      .then((data) => {
        quotes = Array.isArray(data) ? data : [];
        pick();
      })
      .catch(() => {
        if (textEl) textEl.textContent = 'Could not load quotes. Try the full list instead.';
      });

    againBtn?.addEventListener('click', pick);
  </script>
</BaseLayout>
