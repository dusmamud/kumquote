---
import BaseLayout from '../../layouts/BaseLayout.astro';

const site = Astro.site?.toString() ?? 'https://kumquote.pages.dev/';
---
<BaseLayout
  title="Random quote — KumQuote"
  description="A random quote from KumQuote — refresh for another one."
  canonical={`${site}random/`}
  currentPath="/random/"
>
  <h1 class="font-display text-display-h1 font-bold text-ink dark:text-text-dark">Random quote</h1>
  <p class="mt-3 max-w-[65ch] text-lg leading-relaxed text-muted dark:text-text-dark-3">A static site has no server to pick a random quote, so this page picks one in your browser from the full quote list.</p>

  <div class="mt-8 rounded-2xl bg-ink px-6 py-10 text-cream sm:px-10 sm:py-12 dark:border dark:border-border-dark dark:bg-surface-dark">
    <span aria-hidden="true" class="block h-1 w-12 rounded-full bg-gold"></span>
    <blockquote id="random-text" class="mt-5 font-display text-display-quote font-bold tracking-[-0.01em]">Loading a quote…</blockquote>
    <p class="mt-5 text-lg">
      — <a id="random-author" href="/quotes/" class="font-semibold text-gold-light underline decoration-gold-light/50 underline-offset-4">…</a>
      <span id="random-category" class="ms-2 text-[15px] capitalize text-cream/70"></span>
    </p>
    <p class="mt-8 flex flex-wrap gap-3">
      <button
        type="button"
        id="random-again"
        class="flex min-h-[44px] items-center rounded-lg bg-gold px-5 text-[15px] font-semibold text-ink transition-opacity duration-150 hover:opacity-90"
      >
        Another quote
      </button>
      <a id="random-link" href="/quotes/" class="flex min-h-[44px] items-center rounded-lg border border-cream/40 px-5 text-[15px] font-semibold text-cream transition-colors duration-150 hover:border-cream">Read the meaning →</a>
    </p>
    <p class="mt-6 text-sm text-cream/60">Tip: press <kbd class="rounded border border-cream/30 px-1.5 py-0.5 font-sans text-[13px]">N</kbd> for another quote.</p>
  </div>
  <noscript><p class="mt-6">Random quotes need JavaScript. Browse <a href="/quotes/" class="font-semibold text-brand underline dark:text-brand-dark">all quotes</a> instead.</p></noscript>

  <script>
    // Quotes come from /quotes-data.json (built at build time).
    // Everything is inserted as text, never as HTML.
    const textEl = document.getElementById('random-text');
    const authorEl = document.getElementById('random-author');
    const categoryEl = document.getElementById('random-category');
    const linkEl = document.getElementById('random-link');
    const againBtn = document.getElementById('random-again');
    let quotes = [];
    let lastIndex = -1;

    function pick() {
      if (quotes.length === 0) return;
      let i = Math.floor(Math.random() * quotes.length);
      if (quotes.length > 1) {
        while (i === lastIndex) i = Math.floor(Math.random() * quotes.length);
      }
      lastIndex = i;
      const q = quotes[i];
      if (textEl) textEl.textContent = `“${q.text}”`;
      if (authorEl) {
        authorEl.textContent = q.author;
        authorEl.href = `/author/${q.authorSlug}/`;
      }
      if (categoryEl) categoryEl.textContent = q.category;
      if (linkEl) linkEl.href = q.url;
    }

    fetch('/quotes-data.json')
      .then((r) => r.json())
      .then((data) => {
        quotes = Array.isArray(data) ? data : [];
        pick();
      })
      .catch(() => {
        if (textEl) textEl.textContent = 'Could not load quotes. Try the full list instead.';
      });

    againBtn?.addEventListener('click', pick);
    // Press N for another quote (ignored while typing in a field).
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'n' && event.key !== 'N') return;
      const tag = document.activeElement?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      pick();
    });
  </script>
</BaseLayout>
