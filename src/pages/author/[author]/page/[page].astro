---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import QuoteCard from '../../../../components/QuoteCard.astro';
import Pagination from '../../../../components/Pagination.astro';
import { publishedQuotes, authorCounts, authorSlug, authorUrl, totalPages, pageSlice } from '../../../../lib/quotes';

export async function getStaticPaths() {
  const authors = await authorCounts();
  const paths = [];
  for (const { author, count } of authors) {
    const lastPage = totalPages(count);
    for (let pageNum = 2; pageNum <= lastPage; pageNum++) {
      paths.push({ params: { author: authorSlug(author), page: String(pageNum) }, props: { author, pageNum, total: count, lastPage } });
    }
  }
  return paths;
}

const { author, pageNum, total, lastPage } = Astro.props;
const quotes = (await publishedQuotes()).filter((q) => authorSlug(q.data.author) === authorSlug(author));
const pageQuotes = pageSlice(quotes, pageNum);
const site = Astro.site?.toString() ?? 'https://kumquote.pages.dev/';
---
<BaseLayout
  title={`${author} quotes — page ${pageNum} — KumQuote`}
  description={`Quotes by ${author} on KumQuote — ${total} ${total === 1 ? 'quote' : 'quotes'} with the meaning behind each one. Page ${pageNum} of ${lastPage}.`}
  canonical={`${site}${authorUrl(author).slice(1)}page/${pageNum}/`}
  currentPath={authorUrl(author)}
>
  <h1 class="font-display text-display-h1 font-bold text-ink dark:text-text-dark">{author}</h1>
  <p class="mt-3 text-lg text-muted dark:text-text-dark-3">{total} {total === 1 ? 'quote' : 'quotes'} · Page {pageNum} of {lastPage}</p>
  <div class="mt-8 grid gap-5 sm:grid-cols-2">
    {pageQuotes.map((entry) => <QuoteCard entry={entry} />)}
  </div>
  <Pagination currentPage={pageNum} lastPage={lastPage} base={authorUrl(author)} />
  <p class="mt-10"><a href="/quotes/" class="flex min-h-[44px] items-center gap-2 font-semibold text-brand underline dark:text-brand-dark">← Back to all quotes</a></p>
</BaseLayout>
