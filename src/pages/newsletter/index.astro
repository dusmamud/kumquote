---
import BaseLayout from '../../layouts/BaseLayout.astro';

const site = Astro.site?.toString() ?? 'https://kumquote.pages.dev/';
const feedUrl = `${site}rss.xml`;
---
<BaseLayout
  title="Daily quote — KumQuote"
  description="Get one new KumQuote quote every day in your feed reader — no account, no spam. Email edition coming soon."
  canonical={`${site}newsletter/`}
  currentPath="/newsletter/"
>
  <h1 data-reveal class="font-display text-display-h1 font-bold text-ink dark:text-text-dark">Get the daily quote</h1>
  <p class="mt-3 max-w-[65ch] text-lg leading-relaxed text-muted dark:text-text-dark-3">KumQuote adds new quotes every day. The daily quote comes to you through RSS — one new quote in your feed reader each day, no account and no spam.</p>

  <section aria-label="Subscribe with RSS" class="mt-10 max-w-[65ch]">
    <h2 data-reveal class="font-display text-display-h2 font-bold text-ink dark:text-text-dark">Subscribe with RSS</h2>
    <p class="mt-4 leading-relaxed text-muted dark:text-text-dark-3">Add the feed to any feed reader — Feedly, Inoreader, NetNewsWire, or your browser's reader. Every new quote appears as a feed item with its meaning.</p>
    <p class="mt-5">
      <a href="/rss.xml" class="flex min-h-[44px] items-center rounded-lg bg-ink px-5 text-[15px] font-semibold text-cream transition-opacity duration-150 hover:opacity-90 dark:bg-brand-dark dark:text-paper-dark">Subscribe via RSS</a>
    </p>
    <p class="mt-4 text-[15px] text-muted dark:text-text-dark-3">Feed address: <code class="rounded bg-cream px-2 py-1 text-[14px] break-all dark:bg-surface-dark">{feedUrl}</code></p>
  </section>

  <section aria-label="Email edition" class="mt-12 max-w-[65ch]">
    <h2 data-reveal class="font-display text-display-h2 font-bold text-ink dark:text-text-dark">Prefer email?</h2>
    <p class="mt-4 leading-relaxed text-muted dark:text-text-dark-3">The email edition is not ready yet — it needs a mailing provider first. Until then, RSS is the way to get the daily quote. If you would like the email edition, let us know via <a href="https://github.com/dusmamud/kumquote/issues/new" target="_blank" rel="noopener noreferrer" class="font-semibold text-brand underline dark:text-brand-dark">GitHub issues</a>.</p>
  </section>
</BaseLayout>
