---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { authorCounts, authorUrl } from '../../lib/quotes';

const authors = await authorCounts();
// Alphabetical, grouped by first letter, so a specific author is
// findable without searching.
const sorted = [...authors].sort((a, b) => a.author.localeCompare(b.author));
const groups = new Map<string, { author: string; count: number }[]>();
for (const a of sorted) {
  const letter = a.author.charAt(0).toUpperCase();
  const list = groups.get(letter) ?? [];
  list.push(a);
  groups.set(letter, list);
}
const site = Astro.site?.toString() ?? 'https://kumquote.pages.dev/';
---
<BaseLayout
  title="All authors — KumQuote"
  description={`All ${authors.length} authors quoted on KumQuote — browse every author and their quotes.`}
  canonical={`${site}authors/`}
  currentPath="/authors/"
  breadcrumbs={[{ name: 'Home', url: site }, { name: 'Authors', url: `${site}authors/` }]}
>
  <h1 data-reveal class="font-display text-display-h1 font-bold text-ink dark:text-text-dark">All authors</h1>
  <p class="mt-3 max-w-[65ch] text-lg text-muted dark:text-text-dark-3">{authors.length} authors — A to Z.</p>

  {[...groups.entries()].map(([letter, list]) => (
    <section aria-label={`Authors starting with ${letter}`} class="mt-10">
      <h2 data-reveal class="font-display text-display-h2 font-bold text-ink dark:text-text-dark">{letter}</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {list.map(({ author, count }) => (
          <li data-reveal>
            <a href={authorUrl(author)} class="poster-card flex min-h-[44px] items-center justify-between gap-3 rounded-xl border border-border bg-surface px-4 py-3 transition-colors duration-150 hover:border-brand dark:border-border-dark dark:bg-surface-dark dark:hover:border-brand-dark">
              <span class="font-display text-lg font-bold text-ink dark:text-text-dark">{author}</span>
              <span class="shrink-0 text-sm tabular-nums text-muted dark:text-text-dark-3">{count} {count === 1 ? 'quote' : 'quotes'}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
