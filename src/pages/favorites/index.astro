---
import BaseLayout from '../../layouts/BaseLayout.astro';

const site = Astro.site?.toString() ?? 'https://kumquote.pages.dev/';
---
<BaseLayout
  title="My favorite quotes — KumQuote"
  description="Quotes you saved on KumQuote — stored in this browser only, no account needed."
  canonical={`${site}favorites/`}
  currentPath="/favorites/"
>
  <h1 data-reveal class="font-display text-display-h1 font-bold text-ink dark:text-text-dark">My favorite quotes</h1>
  <p class="mt-3 max-w-[65ch] text-lg text-muted dark:text-text-dark-3">Quotes you saved — stored in this browser only, no account needed. They stay here until you remove them.</p>

  <div id="favorites-list" class="mt-8 grid gap-5 sm:grid-cols-2"></div>
  <p id="favorites-empty" class="mt-8 max-w-[65ch] text-lg text-muted dark:text-text-dark-3" hidden>No favorites yet. Tap the heart on any quote to save it here.</p>
  <noscript><p class="mt-8 max-w-[65ch] text-lg text-muted dark:text-text-dark-3">Favorites need JavaScript — they are saved in your browser. Browse <a href="/quotes/" class="font-semibold text-brand underline dark:text-brand-dark">all quotes</a> instead.</p></noscript>
  <p class="mt-10"><a href="/quotes/" class="flex min-h-[44px] items-center gap-2 font-semibold text-brand underline dark:text-brand-dark">← Back to all quotes</a></p>
</BaseLayout>
