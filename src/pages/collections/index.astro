---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COLLECTIONS } from '../../data/collections';

const site = Astro.site?.toString() ?? 'https://kumquote.pages.dev/';
---
<BaseLayout
  title="Collections — KumQuote"
  description="Hand-picked collections of quotes on one theme — for hard days, for mornings, and on gratitude."
  canonical={`${site}collections/`}
  currentPath="/collections/"
>
  <h1 data-reveal class="font-display text-display-h1 font-bold text-ink dark:text-text-dark">Collections</h1>
  <p class="mt-3 max-w-[65ch] text-lg text-muted dark:text-text-dark-3">Hand-picked sets of quotes on one theme — a place to start when a category feels too wide.</p>

  <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {COLLECTIONS.map((c) => (
      <li data-reveal class="poster-card flex flex-col rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark">
        <span aria-hidden="true" class="h-1 w-10 rounded-full bg-gold"></span>
        <h2 class="mt-4 font-display text-display-card font-bold text-ink dark:text-text-dark">
          <a href={`/collections/${c.slug}/`} class="transition-colors duration-150 hover:text-brand dark:hover:text-brand-dark">{c.title}</a>
        </h2>
        <p class="mt-2 flex-1 leading-relaxed text-muted dark:text-text-dark-3">{c.description}</p>
        <p class="mt-4 text-[15px] font-medium text-muted dark:text-text-dark-3">{c.quotes.length} quotes →</p>
      </li>
    ))}
  </ul>

  <p class="mt-10"><a href="/quotes/" class="flex min-h-[44px] items-center gap-2 font-semibold text-brand underline dark:text-brand-dark">← Back to all quotes</a></p>
</BaseLayout>
