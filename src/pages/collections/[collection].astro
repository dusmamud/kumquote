---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import { publishedQuotes, quoteSlug, quoteItemList } from '../../lib/quotes';
import { COLLECTIONS, getCollection } from '../../data/collections';

export async function getStaticPaths() {
  return COLLECTIONS.map((c) => ({ params: { collection: c.slug } }));
}

const { collection } = Astro.params;
const data = getCollection(collection ?? '');
if (!data) {
  throw new Error(`Unknown collection: ${collection}`);
}
const all = await publishedQuotes();
const bySlug = new Map(all.map((q) => [quoteSlug(q), q]));
const quotes = data.quotes.map((s) => bySlug.get(s)).filter((q) => q !== undefined);
const site = Astro.site?.toString() ?? 'https://kumquote.pages.dev/';
---
<BaseLayout
  title={`${data.title} — KumQuote`}
  description={data.description}
  canonical={`${site}collections/${data.slug}/`}
  currentPath="/collections/"
  breadcrumbs={[{ name: 'Home', url: site }, { name: 'Collections', url: `${site}collections/` }, { name: data.title, url: `${site}collections/${data.slug}/` }]}
  itemList={quoteItemList(quotes, site)}
>
  <p class="text-sm font-semibold uppercase tracking-[0.12em] text-brand dark:text-brand-dark">Collection</p>
  <h1 data-reveal class="mt-2 font-display text-display-h1 font-bold text-ink dark:text-text-dark">{data.title}</h1>
  <p class="mt-3 max-w-[65ch] text-lg text-muted dark:text-text-dark-3">{data.description}</p>

  <div class="mt-8 grid gap-5 sm:grid-cols-2">
    {quotes.map((q) => <QuoteCard entry={q} />)}
  </div>

  <section aria-label="More collections" class="mt-12">
    <h2 data-reveal class="font-display text-display-h2 font-bold text-ink dark:text-text-dark">More collections</h2>
    <ul class="mt-5 flex flex-wrap gap-2">
      {COLLECTIONS.filter((c) => c.slug !== data.slug).map((c) => (
        <li><a href={`/collections/${c.slug}/`} class="flex min-h-[44px] items-center rounded-md border border-border bg-surface px-4 text-sm font-medium transition-colors duration-150 hover:border-brand hover:text-brand dark:border-border-dark-2 dark:bg-surface-dark dark:hover:border-brand-dark dark:hover:text-brand-dark">{c.title}</a></li>
      ))}
      <li><a href="/collections/" class="flex min-h-[44px] items-center rounded-md border border-border bg-surface px-4 text-sm font-medium transition-colors duration-150 hover:border-brand hover:text-brand dark:border-border-dark-2 dark:bg-surface-dark dark:hover:border-brand-dark dark:hover:text-brand-dark">All collections</a></li>
    </ul>
  </section>
</BaseLayout>
