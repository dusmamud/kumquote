---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedQuotes, authorCounts, categoryCounts, tagCounts } from '../../lib/quotes';

const quotes = await publishedQuotes();
const authors = await authorCounts();
const categories = await categoryCounts();
const tags = await tagCounts();
const site = Astro.site?.toString() ?? 'https://kumquote.pages.dev/';
---
<BaseLayout
  title="About — KumQuote"
  description="What KumQuote is, how its quotes are chosen and checked, and how to get in touch."
  canonical={`${site}about/`}
  currentPath="/about/"
>
  <h1 data-reveal class="font-display text-display-h1 font-bold text-ink dark:text-text-dark">About KumQuote</h1>
  <p class="mt-3 max-w-[65ch] text-lg leading-relaxed text-muted dark:text-text-dark-3">KumQuote is a collection of quotes worth remembering — famous quotes with the meaning behind them, not just the words. New quotes are added every day.</p>

  <section aria-label="KumQuote in numbers" class="mt-10">
    <h2 data-reveal class="font-display text-display-h2 font-bold text-ink dark:text-text-dark">KumQuote in numbers</h2>
    <ul class="mt-5 grid gap-5 sm:grid-cols-2">
      <li data-reveal class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark"><span class="block font-display text-display-h2 font-bold text-ink dark:text-text-dark">{quotes.length}</span><span class="mt-1 block text-[15px] text-muted dark:text-text-dark-3">quotes</span></li>
      <li data-reveal class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark"><span class="block font-display text-display-h2 font-bold text-ink dark:text-text-dark">{authors.length}</span><span class="mt-1 block text-[15px] text-muted dark:text-text-dark-3">authors</span></li>
      <li data-reveal class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark"><span class="block font-display text-display-h2 font-bold text-ink dark:text-text-dark">{categories.length}</span><span class="mt-1 block text-[15px] text-muted dark:text-text-dark-3">categories</span></li>
      <li data-reveal class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark"><span class="block font-display text-display-h2 font-bold text-ink dark:text-text-dark">{tags.length}</span><span class="mt-1 block text-[15px] text-muted dark:text-text-dark-3">tags</span></li>
    </ul>
  </section>

  <section aria-label="How quotes are chosen" class="mt-12 max-w-[65ch]">
    <h2 data-reveal class="font-display text-display-h2 font-bold text-ink dark:text-text-dark">How quotes are chosen</h2>
    <p class="mt-4 leading-relaxed text-muted dark:text-text-dark-3">Every quote here is a real, well-known quote — never invented, and never given to the wrong person on purpose. Each one comes with a short meaning written in plain words: what it says, and how to use it today.</p>
    <p class="mt-4 leading-relaxed text-muted dark:text-text-dark-3">A source — the book, speech, or interview a quote came from — is shown only where we are certain of it. Where the source is not certain, no source is shown rather than a guessed one.</p>
  </section>

  <section aria-label="Corrections" class="mt-12 max-w-[65ch]">
    <h2 data-reveal class="font-display text-display-h2 font-bold text-ink dark:text-text-dark">Spot a mistake?</h2>
    <p class="mt-4 leading-relaxed text-muted dark:text-text-dark-3">Quote sites get attributions wrong all the time, and we would rather be corrected than confident. If a quote is misattributed, or a meaning misses the point, tell us — corrections are welcome. The fastest way is to <a href="https://github.com/dusmamud/kumquote/issues/new" target="_blank" rel="noopener noreferrer" class="font-semibold text-brand underline dark:text-brand-dark">open an issue on GitHub</a>.</p>
  </section>

  <section aria-label="Browse" class="mt-12">
    <h2 data-reveal class="font-display text-display-h2 font-bold text-ink dark:text-text-dark">Browse KumQuote</h2>
    <ul class="mt-5 flex flex-wrap gap-2">
      <li><a href="/quotes/" class="flex min-h-[44px] items-center rounded-md border border-border bg-surface px-4 text-sm font-medium transition-colors duration-150 hover:border-brand hover:text-brand dark:border-border-dark-2 dark:bg-surface-dark dark:hover:border-brand-dark dark:hover:text-brand-dark">All quotes</a></li>
      <li><a href="/authors/" class="flex min-h-[44px] items-center rounded-md border border-border bg-surface px-4 text-sm font-medium transition-colors duration-150 hover:border-brand hover:text-brand dark:border-border-dark-2 dark:bg-surface-dark dark:hover:border-brand-dark dark:hover:text-brand-dark">Authors</a></li>
      <li><a href="/categories/" class="flex min-h-[44px] items-center rounded-md border border-border bg-surface px-4 text-sm font-medium transition-colors duration-150 hover:border-brand hover:text-brand dark:border-border-dark-2 dark:bg-surface-dark dark:hover:border-brand-dark dark:hover:text-brand-dark">Categories</a></li>
      <li><a href="/collections/" class="flex min-h-[44px] items-center rounded-md border border-border bg-surface px-4 text-sm font-medium transition-colors duration-150 hover:border-brand hover:text-brand dark:border-border-dark-2 dark:bg-surface-dark dark:hover:border-brand-dark dark:hover:text-brand-dark">Collections</a></li>
      <li><a href="/random/" class="flex min-h-[44px] items-center rounded-md border border-border bg-surface px-4 text-sm font-medium transition-colors duration-150 hover:border-brand hover:text-brand dark:border-border-dark-2 dark:bg-surface-dark dark:hover:border-brand-dark dark:hover:text-brand-dark">Random quote</a></li>
      <li><a href="/submit/" class="flex min-h-[44px] items-center rounded-md border border-border bg-surface px-4 text-sm font-medium transition-colors duration-150 hover:border-brand hover:text-brand dark:border-border-dark-2 dark:bg-surface-dark dark:hover:border-brand-dark dark:hover:text-brand-dark">Submit a quote</a></li>
    </ul>
  </section>

  <p class="mt-12 text-[15px] text-muted dark:text-text-dark-3">KumQuote is made and curated by Dus Mamud. Contact: see the <a href="/contact/" class="font-semibold text-brand underline dark:text-brand-dark">contact page</a>.</p>
</BaseLayout>
