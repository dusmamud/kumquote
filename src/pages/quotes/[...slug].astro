---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import CopyButton from '../../components/CopyButton.astro';
import { publishedQuotes, findQuote, quoteSlug, quoteUrl, authorUrl, categoryUrl, tagUrl, relatedQuotes, quoteTitle, isoDate } from '../../lib/quotes';

export async function getStaticPaths() {
  const quotes = await publishedQuotes();
  return quotes.map((entry) => ({ params: { slug: quoteSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { text, author, authorRole, category, tags, source } = entry.data;
// Description = first paragraph of the meaning, plain text, <= 155 chars.
const bodyText = (typeof entry.body === 'string' ? entry.body : '').replace(/[#>*`]/g, '').replace(/\s+/g, ' ').trim();
const description = bodyText.length > 155 ? `${bodyText.slice(0, 152).trimEnd()}…` : bodyText;
const site = Astro.site?.toString() ?? 'https://kumquote.pages.dev/';
const canonical = `${site}quotes/${quoteSlug(entry)}/`;
const title = `“${quoteTitle(entry)}” — ${author} | KumQuote`;
const shareText = `“${text}” — ${author}`;
const xShare = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(canonical)}`;
const waShare = `https://wa.me/?text=${encodeURIComponent(`${shareText} ${canonical}`)}`;
const related = await relatedQuotes(entry, 3);
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="quote"
  publishedTime={entry.data.pubDate.toISOString()}
  updatedTime={entry.data.updatedDate?.toISOString()}
  image={entry.data.ogImage}
  quotation={{ text, author }}
  currentPath={quoteUrl(entry)}
>
  <nav aria-label="Breadcrumb" class="text-sm text-muted dark:text-text-dark-3">
    <ol class="flex flex-wrap items-center gap-2">
      <li><a href="/" class="flex min-h-[44px] items-center font-semibold text-brand underline dark:text-brand-dark">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/quotes/" class="flex min-h-[44px] items-center font-semibold text-brand underline dark:text-brand-dark">Quotes</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={categoryUrl(category)} class="flex min-h-[44px] items-center font-semibold capitalize text-brand underline dark:text-brand-dark">{category}</a></li>
    </ol>
  </nav>

  <!-- Poster: centred, gold rule, Playfair Bold at poster size. -->
  <article class="mx-auto mt-8 max-w-3xl text-center">
    <span aria-hidden="true" class="mx-auto block h-1 w-12 rounded-full bg-gold"></span>
    <blockquote class="mt-6 font-display text-display-quote font-bold tracking-[-0.01em] text-ink dark:text-text-dark">“{text}”</blockquote>
    <p class="mt-6 text-lg text-muted dark:text-text-dark-3">
      — <a href={authorUrl(author)} class="font-semibold uppercase tracking-[0.08em] text-brand dark:text-brand-dark">{author}</a>
      {authorRole ? `, ${authorRole}` : ''}
      {source ? <span class="mt-1 block text-[15px] text-muted dark:text-text-dark-3">Source: {source}</span> : ''}
    </p>
    <p class="mt-2 text-sm text-muted dark:text-text-dark-3">
      Published <time datetime={isoDate(entry.data.pubDate)}>{isoDate(entry.data.pubDate)}</time>
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <CopyButton text={text} />
      <a href={xShare} target="_blank" rel="noopener noreferrer" class="flex min-h-[44px] items-center rounded-lg border border-border px-4 text-[15px] font-medium transition-colors duration-150 hover:border-brand hover:text-brand dark:border-border-dark-2 dark:hover:border-brand-dark dark:hover:text-brand-dark">Share on X</a>
      <a href={waShare} target="_blank" rel="noopener noreferrer" class="flex min-h-[44px] items-center rounded-lg border border-border px-4 text-[15px] font-medium transition-colors duration-150 hover:border-brand hover:text-brand dark:border-border-dark-2 dark:hover:border-brand-dark dark:hover:text-brand-dark">Share on WhatsApp</a>
    </div>

    <div class="prose prose-stone mt-12 max-w-none text-left dark:prose-invert prose-headings:font-display prose-a:text-brand dark:prose-a:text-brand-dark">
      <h2>What it means</h2>
      <Content />
    </div>

    {tags.length > 0 && (
      <div class="mt-10 text-left">
        <h2 class="text-sm font-semibold uppercase tracking-[0.12em] text-muted dark:text-text-dark-3">Tags</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li><a href={tagUrl(tag)} class="flex min-h-[44px] items-center rounded-md border border-border bg-surface px-4 text-sm font-medium transition-colors duration-150 hover:border-brand hover:text-brand dark:border-border-dark-2 dark:bg-surface-dark dark:hover:border-brand-dark dark:hover:text-brand-dark">{tag}</a></li>
          ))}
        </ul>
      </div>
    )}
  </article>

  {related.length > 0 && (
    <section class="mt-14">
      <h2 class="font-display text-display-h2 font-bold text-ink dark:text-text-dark">More quotes like this</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((q) => <QuoteCard entry={q} />)}
      </div>
    </section>
  )}

  <p class="mt-10"><a href="/quotes/" class="flex min-h-[44px] items-center gap-2 font-semibold text-brand underline dark:text-brand-dark">← Back to all quotes</a></p>

  <script>
    // Copy buttons: clipboard API with a textarea fallback. The label
    // flips to "Copied" for 2 seconds, then flips back.
    document.querySelectorAll('[data-copy-text]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy-text') ?? '';
        const original = btn.textContent;
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = original; }, 2000);
      });
    });
  </script>
</BaseLayout>
