---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import QuoteCard from '../../../../components/QuoteCard.astro';
import Pagination from '../../../../components/Pagination.astro';
import { publishedQuotes, tagCounts, tagUrl, slugify, totalPages, pageSlice, quoteItemList } from '../../../../lib/quotes';

export async function getStaticPaths() {
  const tags = await tagCounts();
  const paths = [];
  for (const { tag, count } of tags) {
    const lastPage = totalPages(count);
    for (let pageNum = 2; pageNum <= lastPage; pageNum++) {
      paths.push({ params: { tag: slugify(tag), page: String(pageNum) }, props: { tag, pageNum, total: count, lastPage } });
    }
  }
  return paths;
}

const { tag, pageNum, total, lastPage } = Astro.props;
const quotes = (await publishedQuotes()).filter((q) => (q.data.tags ?? []).some((t) => slugify(t) === slugify(tag)));
const pageQuotes = pageSlice(quotes, pageNum);
const site = Astro.site?.toString() ?? 'https://kumquote.pages.dev/';
---
<BaseLayout
  title={`Quotes tagged “${tag}” — page ${pageNum} — KumQuote`}
  description={`Quotes tagged “${tag}” on KumQuote — ${total} ${total === 1 ? 'quote' : 'quotes'}. Page ${pageNum} of ${lastPage}.`}
  canonical={`${site}${tagUrl(tag).slice(1)}page/${pageNum}/`}
  currentPath={tagUrl(tag)}
  breadcrumbs={[{ name: 'Home', url: site }, { name: 'Tags', url: `${site}tags/` }, { name: tag, url: `${site}${tagUrl(tag).slice(1)}` }]}
  itemList={quoteItemList(pageQuotes, site)}
>
  <h1 class="font-display text-display-h1 font-bold text-ink dark:text-text-dark">“{tag}”</h1>
  <p class="mt-3 text-lg text-muted dark:text-text-dark-3">{total} {total === 1 ? 'quote' : 'quotes'} · Page {pageNum} of {lastPage}</p>
  <div class="mt-8 grid gap-5 sm:grid-cols-2">
    {pageQuotes.map((entry) => <QuoteCard entry={entry} />)}
  </div>
  <Pagination currentPage={pageNum} lastPage={lastPage} base={tagUrl(tag)} />
  <p class="mt-10"><a href="/quotes/" class="flex min-h-[44px] items-center gap-2 font-semibold text-brand underline dark:text-brand-dark">← Back to all quotes</a></p>
</BaseLayout>
