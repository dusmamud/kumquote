---
import BaseLayout from '../layouts/BaseLayout.astro';

const site = Astro.site?.toString() ?? 'https://kumquote.pages.dev/';
---
<BaseLayout
  title="Page not found — KumQuote"
  description="That page does not exist on KumQuote."
  canonical={site}
  currentPath="/404/"
>
  <h1 class="font-display text-4xl">Page not found</h1>
  <p class="mt-4 max-w-[65ch] text-lg leading-relaxed text-stone-600 dark:text-text-dark-3">That quote, author, or page does not exist — it may have moved, or the link may have a typo.</p>
  <p class="mt-6 flex flex-wrap gap-3">
    <a href="/" class="flex min-h-[44px] items-center rounded-lg bg-brand px-5 text-[15px] text-white transition-opacity duration-150 hover:opacity-90 dark:bg-brand-dark dark:text-paper-dark">Go home</a>
    <a href="/quotes/" class="flex min-h-[44px] items-center rounded-lg border border-stone-300 px-5 text-[15px] font-medium transition-colors duration-150 hover:border-brand hover:text-brand dark:border-border-dark-2 dark:hover:border-brand-dark dark:hover:text-brand-dark">Browse all quotes</a>
  </p>
</BaseLayout>
