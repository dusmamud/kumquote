---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import { publishedQuotes, categoryCounts, categoryUrl } from '../../lib/quotes';

export async function getStaticPaths() {
  const categories = await categoryCounts();
  return categories.map(({ category }) => ({ params: { category }, props: { category } }));
}

const { category } = Astro.props;
const quotes = (await publishedQuotes()).filter((q) => q.data.category === category);
const site = Astro.site?.toString() ?? 'https://kumquote.pages.dev/';
const label = category.charAt(0).toUpperCase() + category.slice(1);
---
<BaseLayout
  title={`${label} quotes — KumQuote`}
  description={`${label} quotes on KumQuote — ${quotes.length} ${quotes.length === 1 ? 'quote' : 'quotes'} with the meaning behind each one.`}
  canonical={`${site}${categoryUrl(category).slice(1)}`}
  currentPath={categoryUrl(category)}
>
  <h1 class="font-display text-4xl capitalize">{category} quotes</h1>
  <p class="mt-3 text-lg text-stone-600 dark:text-text-dark-3">{quotes.length} {quotes.length === 1 ? 'quote' : 'quotes'}</p>
  <div class="mt-8 border-t border-stone-200 dark:border-border-dark">
    {quotes.map((entry) => <QuoteCard entry={entry} />)}
  </div>
  <p class="mt-10"><a href="/quotes/" class="flex min-h-[44px] items-center gap-2 font-medium text-brand underline dark:text-brand-dark">← Back to all quotes</a></p>
</BaseLayout>
