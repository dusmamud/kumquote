---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteCard from '../components/QuoteCard.astro';
import { publishedQuotes, quoteOfTheDay, categoryCounts, tagCounts, quoteUrl, authorUrl, categoryUrl, tagUrl } from '../lib/quotes';

const quotes = await publishedQuotes();
const today = quoteOfTheDay(quotes);
const featured = quotes.filter((q) => q.data.featured).slice(0, 3);
const latest = quotes.slice(0, 10);
const categories = await categoryCounts();
const tags = (await tagCounts()).slice(0, 12);
const site = Astro.site?.toString() ?? 'https://kumquote.pages.dev/';
---
<BaseLayout
  title="KumQuote — Quotes worth remembering"
  description="Quotes worth remembering — famous quotes with the meaning behind them, by author and category."
  canonical={site}
  currentPath="/"
>
  <section class="grid gap-8 lg:grid-cols-[1.6fr_1fr] lg:items-start">
    <div>
      <p class="hero-in text-sm tabular-nums text-stone-500 dark:text-text-dark-3">
        {quotes.length} quotes
      </p>
      <h1 class="hero-in hero-in-1 mt-4 font-display text-4xl leading-[1.05] sm:text-5xl">Quotes worth remembering, with the meaning behind them.</h1>
      <p class="hero-in hero-in-2 mt-4 max-w-[65ch] text-lg leading-relaxed text-stone-600 dark:text-text-dark-3">Not just the words — what they mean, and how to use them today. Browse by author, category, or let the day pick one for you.</p>
      <p class="hero-in hero-in-3 mt-6 flex flex-wrap gap-3">
        <a href="/quotes/" class="flex min-h-[44px] items-center rounded-lg bg-brand px-5 text-[15px] text-white transition-opacity duration-150 hover:opacity-90 dark:bg-brand-dark dark:text-paper-dark">Browse all quotes</a>
        <a href="/random/" class="flex min-h-[44px] items-center rounded-lg border border-stone-300 px-5 text-[15px] font-medium transition-colors duration-150 hover:border-brand hover:text-brand dark:border-border-dark-2 dark:hover:border-brand-dark dark:hover:text-brand-dark">Random quote</a>
      </p>
    </div>

    {today && (
      <aside aria-label="Quote of the day" class="hero-in hero-in-2 rounded-2xl border border-stone-200 bg-white p-5 dark:border-border-dark dark:bg-surface-dark">
        <p class="text-sm text-stone-500 dark:text-text-dark-3">Quote of the day</p>
        <blockquote class="mt-2 font-display text-2xl leading-snug">
          <a href={quoteUrl(today)} class="hover:text-brand hover:underline dark:hover:text-brand-dark">“{today.data.text}”</a>
        </blockquote>
        <p class="mt-3 text-[15px] leading-relaxed text-stone-600 dark:text-text-dark-3">
          — <a href={authorUrl(today.data.author)} class="font-medium text-brand underline dark:text-brand-dark">{today.data.author}</a>
          {today.data.authorRole ? `, ${today.data.authorRole}` : ''}
        </p>
        <p class="mt-3">
          <a href={quoteUrl(today)} class="inline-flex min-h-[44px] items-center font-medium text-brand underline dark:text-brand-dark">Read the meaning →</a>
        </p>
      </aside>
    )}
  </section>

  {categories.length > 0 && (
    <section aria-label="Categories" class="mt-10">
      <h2 class="font-display text-3xl">Browse by category</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {categories.map(({ category, count }) => (
          <li><a href={categoryUrl(category)} class="flex min-h-[44px] items-center rounded-md border border-stone-300 px-4 text-sm tabular-nums capitalize dark:border-border-dark-2">{category} ({count})</a></li>
        ))}
      </ul>
    </section>
  )}

  {featured.length > 0 && (
    <section aria-label="Featured quotes" class="mt-12">
      <h2 class="font-display text-3xl">Featured</h2>
      <div class="mt-6 border-t border-stone-200 dark:border-border-dark">
        {featured.map((entry) => <QuoteCard entry={entry} />)}
      </div>
    </section>
  )}

  <section class="mt-12">
    <h2 class="font-display text-3xl">Latest quotes</h2>
    {latest.length === 0 ? (
      <p class="mt-4">No quotes yet.</p>
    ) : (
      <div class="mt-6 border-t border-stone-200 dark:border-border-dark">
        {latest.map((entry) => <QuoteCard entry={entry} />)}
      </div>
    )}
    {quotes.length > 10 && (
      <p class="mt-6">
        <a href="/quotes/" class="inline-flex min-h-[44px] items-center font-medium text-brand underline dark:text-brand-dark">View all {quotes.length} quotes</a>
      </p>
    )}
  </section>

  {tags.length > 0 && (
    <section aria-label="Tags" class="mt-12">
      <h2 class="font-display text-3xl">Tags</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {tags.map(({ tag, count }) => (
          <li><a href={tagUrl(tag)} class="flex min-h-[44px] items-center rounded-md border border-stone-300 px-4 text-sm tabular-nums dark:border-border-dark-2">{tag} ({count})</a></li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
