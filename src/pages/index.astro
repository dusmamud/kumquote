---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteCard from '../components/QuoteCard.astro';
import { publishedQuotes, quoteOfTheDay, categoryCounts, tagCounts, quoteUrl, authorUrl, categoryUrl, tagUrl } from '../lib/quotes';

const quotes = await publishedQuotes();
const today = quoteOfTheDay(quotes);
const featured = quotes.filter((q) => q.data.featured).slice(0, 3);
const latest = quotes.slice(0, 10);
const categories = await categoryCounts();
const tags = (await tagCounts()).slice(0, 12);
const site = Astro.site?.toString() ?? 'https://kumquote.pages.dev/';
---
<BaseLayout
  title="KumQuote — Quotes worth remembering"
  description="Quotes worth remembering — famous quotes with the meaning behind them, by author and category."
  canonical={site}
  currentPath="/"
>
  {today && (
    <section aria-label="Quote of the day" class="hero-in rounded-2xl bg-ink px-6 py-10 text-cream sm:px-10 sm:py-14 dark:border dark:border-border-dark dark:bg-surface-dark">
      <p class="hero-in hero-in-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] font-semibold uppercase tracking-[0.18em] text-gold-light">
        <span>Quote of the day</span>
        <span aria-hidden="true" class="text-cream/40">·</span>
        <span class="normal-case tracking-normal text-cream/60">{quotes.length} quotes</span>
      </p>
      <blockquote class="hero-in hero-in-2 mt-5 max-w-[26ch] font-display text-display-hero font-bold tracking-[-0.015em]">
        <a href={quoteUrl(today)} class="transition-colors duration-150 hover:text-gold-light">“{today.data.text}”</a>
      </blockquote>
      <p class="hero-in hero-in-3 mt-5 text-[17px] leading-relaxed">
        — <a href={authorUrl(today.data.author)} class="font-semibold text-gold-light underline decoration-gold-light/50 underline-offset-4">{today.data.author}</a>
        {today.data.authorRole ? <span class="text-cream/70">, {today.data.authorRole}</span> : ''}
      </p>
      <p class="hero-in hero-in-3 mt-8 flex flex-wrap gap-3">
        <a href="/quotes/" class="flex min-h-[44px] items-center rounded-lg bg-gold px-5 text-[15px] font-semibold text-ink transition-opacity duration-150 hover:opacity-90">Browse all quotes</a>
        <a href="/random/" class="flex min-h-[44px] items-center rounded-lg border border-cream/40 px-5 text-[15px] font-semibold text-cream transition-colors duration-150 hover:border-cream hover:text-cream">Random quote</a>
        <a href={quoteUrl(today)} class="flex min-h-[44px] items-center px-2 text-[15px] font-semibold text-gold-light underline decoration-gold-light/50 underline-offset-4">Read the meaning →</a>
      </p>
    </section>
  )}

  <section aria-label="About" class="mt-10 max-w-[65ch]">
    <h1 class="font-display text-display-h1 font-bold text-ink dark:text-text-dark">Quotes worth remembering, with the meaning behind them.</h1>
    <p class="mt-3 text-lg leading-relaxed text-muted dark:text-text-dark-3">Not just the words — what they mean, and how to use them today. Browse by author, category, or let the day pick one for you.</p>
  </section>

  {categories.length > 0 && (
    <section aria-label="Categories" class="mt-12">
      <h2 class="font-display text-display-h2 font-bold text-ink dark:text-text-dark">Browse by category</h2>
      <ul class="mt-5 flex flex-wrap gap-2">
        {categories.map(({ category, count }) => (
          <li><a href={categoryUrl(category)} class="flex min-h-[44px] items-center rounded-md border border-border bg-surface px-4 text-sm font-medium tabular-nums capitalize transition-colors duration-150 hover:border-brand hover:text-brand dark:border-border-dark-2 dark:bg-surface-dark dark:hover:border-brand-dark dark:hover:text-brand-dark">{category} ({count})</a></li>
        ))}
      </ul>
    </section>
  )}

  {featured.length > 0 && (
    <section aria-label="Featured quotes" class="mt-12">
      <h2 class="font-display text-display-h2 font-bold text-ink dark:text-text-dark">Featured</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {featured.map((entry) => <QuoteCard entry={entry} />)}
      </div>
    </section>
  )}

  <section class="mt-12">
    <h2 class="font-display text-display-h2 font-bold text-ink dark:text-text-dark">Latest quotes</h2>
    {latest.length === 0 ? (
      <p class="mt-4">No quotes yet.</p>
    ) : (
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {latest.map((entry) => <QuoteCard entry={entry} />)}
      </div>
    )}
    {quotes.length > 10 && (
      <p class="mt-6">
        <a href="/quotes/" class="inline-flex min-h-[44px] items-center font-semibold text-brand underline dark:text-brand-dark">View all {quotes.length} quotes →</a>
      </p>
    )}
  </section>

  {tags.length > 0 && (
    <section aria-label="Tags" class="mt-12">
      <h2 class="font-display text-display-h2 font-bold text-ink dark:text-text-dark">Tags</h2>
      <ul class="mt-5 flex flex-wrap gap-2">
        {tags.map(({ tag, count }) => (
          <li><a href={tagUrl(tag)} class="flex min-h-[44px] items-center rounded-md border border-border bg-surface px-4 text-sm font-medium tabular-nums transition-colors duration-150 hover:border-brand hover:text-brand dark:border-border-dark-2 dark:bg-surface-dark dark:hover:border-brand-dark dark:hover:text-brand-dark">{tag} ({count})</a></li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
