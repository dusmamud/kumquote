---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tagCounts } from '../../lib/quotes';

const site = Astro.site?.toString() ?? 'https://kumquote.pages.dev/';
const tags = await tagCounts();
const popular = tags.slice(0, 5).map((x) => x.tag);
const searchingText = 'Searching…';
---
<BaseLayout
  title="Search — KumQuote"
  description="Search quotes by words, author, category, or tag."
  canonical={`${site}search/`}
  currentPath="/search/"
>
  <h1 class="font-display text-display-h1 font-bold text-ink dark:text-text-dark">Search</h1>
  <form role="search" class="mt-6" onsubmit="return false;">
    <label for="search-input" class="sr-only">Search quotes</label>
    <input
      id="search-input"
      name="q"
      type="search"
      placeholder="Search quotes, authors, categories…"
      autocomplete="off"
      class="h-12 w-full rounded-lg border border-border bg-surface px-4 text-[16px] dark:border-border-dark-2 dark:bg-surface-dark"
    />
  </form>
  <p class="mt-3 text-sm text-muted dark:text-text-dark-3">Type at least 2 characters. Quotes, authors, and tags are all searchable.</p>

  {popular.length > 0 && (
    <section aria-label="Popular searches" class="mt-6">
      <h2 class="text-sm font-semibold uppercase tracking-[0.12em] text-muted dark:text-text-dark-3">Popular searches</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {popular.map((tag) => (
          <li><button type="button" data-search-term={tag} class="search-term flex min-h-[44px] items-center rounded-md border border-border bg-surface px-4 text-sm font-medium transition-colors duration-150 hover:border-brand hover:text-brand dark:border-border-dark-2 dark:bg-surface-dark dark:hover:border-brand-dark dark:hover:text-brand-dark">{tag}</button></li>
        ))}
      </ul>
    </section>
  )}

  <div id="search-results" class="mt-6 flex flex-col gap-4" aria-live="polite"></div>
  <p id="search-status" class="mt-4 text-sm text-muted"></p>
  <p id="search-empty" class="mt-4 hidden text-sm text-muted dark:text-text-dark-3">No quotes found. Try another word or an author name.</p>

  <script define:vars={{ noIndexText: 'Search index is not built yet. Run npm run build first.', searchingText }}>
    // Pagefind is generated by `npm run build` into /pagefind/.
    // In dev it does not exist yet, so fail gracefully instead of
    // showing a broken search box.
    const input = document.getElementById('search-input');
    const resultsEl = document.getElementById('search-results');
    const statusEl = document.getElementById('search-status');
    const emptyEl = document.getElementById('search-empty');
    let pagefind = null;
    let timer = null;

    async function init() {
      try {
        pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
        await pagefind.init();
      } catch {
        if (statusEl) statusEl.textContent = noIndexText;
      }
    }

    async function run(query) {
      if (!pagefind || !resultsEl) return;
      const search = await pagefind.search(query);
      const all = await Promise.all(search.results.slice(0, 20).map((r) => r.data()));
      const items = all.slice(0, 10);
      if (statusEl) statusEl.textContent = `${items.length} ${items.length === 1 ? 'result' : 'results'}`;
      if (emptyEl) emptyEl.classList.toggle('hidden', items.length > 0);
      // Never innerHTML a string: titles and excerpts come from the
      // build index, but they are still inserted as text, not HTML.
      resultsEl.replaceChildren();
      items.forEach((item) => {
        const article = document.createElement('article');
        article.className = 'rounded-xl border border-border bg-surface p-4 dark:border-border-dark dark:bg-surface-dark';
        const h2 = document.createElement('h2');
        const link = document.createElement('a');
        link.href = item.url;
        link.className = 'font-semibold text-brand underline dark:text-brand-dark';
        link.textContent = item.meta?.title ?? item.url;
        h2.appendChild(link);
        const p = document.createElement('p');
        p.className = 'mt-1 text-sm text-muted dark:text-text-dark-3';
        p.textContent = item.excerpt ?? '';
        article.append(h2, p);
        resultsEl.appendChild(article);
      });
    }

    function trigger(query) {
      if (input) input.value = query;
      clearTimeout(timer);
      if (query.trim().length < 2) {
        if (resultsEl) resultsEl.replaceChildren();
        if (emptyEl) emptyEl.classList.add('hidden');
        if (statusEl) statusEl.textContent = '';
        return;
      }
      if (statusEl) statusEl.textContent = searchingText;
      timer = setTimeout(() => run(query.trim()), 200);
    }

    input?.addEventListener('input', (event) => trigger(event.target.value));
    document.querySelectorAll('.search-term').forEach((btn) => {
      btn.addEventListener('click', () => trigger(btn.dataset.searchTerm ?? ''));
    });

    init();
  </script>
</BaseLayout>
