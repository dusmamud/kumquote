---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '@fontsource/instrument-serif';
import '@fontsource/instrument-serif/400-italic.css';
/* Preload ONLY the above-fold font: Instrument latin 400 (hero, nav,
   body). Vite ?url gives the same hashed asset the @font-face CSS
   references, so there is no double download. crossorigin is required
   even for self-hosted fonts, otherwise the preload is wasted. */
import instrumentLatin400 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  canonical: string;
  type?: 'website' | 'quote';
  publishedTime?: string;
  updatedTime?: string;
  image?: string;
  quotation?: { text: string; author: string };
  currentPath: string;
}

const {
  title, description, canonical, type = 'website',
  publishedTime, updatedTime, image, quotation, currentPath,
} = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbf8f3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#08090a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={instrumentLatin400} />
    <!-- Theme before paint: System / Light / Dark.
         Stored choice wins; otherwise the OS choice (System).
         Stored in localStorage as 'kumquote-theme'. The Header toggle
         cycles System -> Light -> Dark and re-applies this same rule,
         so there is never a flash of the wrong theme. -->
    <script is:inline>
      try {
        var stored = localStorage.getItem('kumquote-theme');
        var mode = stored === 'light' || stored === 'dark' ? stored : 'system';
        var dark = mode === 'dark' || (mode === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = mode;
        if (dark) document.documentElement.classList.add('dark');
      } catch (e) {
        /* ignore: private mode */
      }
    </script>
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      type={type}
      publishedTime={publishedTime}
      updatedTime={updatedTime}
      image={image}
      quotation={quotation}
    />
    <link rel="alternate" type="application/rss+xml" title="KumQuote RSS" href="/rss.xml" />
  </head>
  <body class="bg-paper font-sans text-ink antialiased dark:bg-paper-dark dark:text-text-dark-2" id="top">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header currentPath={currentPath} />
    <main id="main-content" tabindex="-1" class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
      <slot />
    </main>
    <Footer />
  </body>
</html>
